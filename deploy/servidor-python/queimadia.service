# /etc/systemd/system/queimadia.service
[Unit]
Description=QueimadIA - Radar de Queimadas Suspeitas (NIPED/PCAM/DPTC)
After=network-online.target
Wants=network-online.target

[Service]
User=queimadia
WorkingDirectory=/opt/queimadia
EnvironmentFile=-/opt/queimadia/.env
Environment=HOST=127.0.0.1 PORT=8090
ExecStart=/opt/queimadia/.venv/bin/python -m motor.servidor
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
